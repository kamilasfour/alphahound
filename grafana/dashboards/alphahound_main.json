          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Ingest Errors (last 24h)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "efkez839cfz7kd" },
          "rawSql": "SELECT NOW() AS time, COUNT(*) AS value FROM ingest_runs WHERE error IS NOT NULL AND started_at > NOW() - INTERVAL '24 hours'",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "efkez839cfz7kd" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Total raw_posts",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "efkez839cfz7kd" },
          "rawSql": "SELECT NOW() AS time, COUNT(*) AS value FROM raw_posts",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "efkez839cfz7kd" },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 }, "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 5 },
      "id": 5,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Posts written per adapter over time",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "efkez839cfz7kd" },
          "rawSql": "SELECT $__timeGroupAlias(started_at, '15m'), adapter_id AS metric, SUM(posts_written) AS value FROM ingest_runs WHERE $__timeFilter(started_at) AND finished_at IS NOT NULL GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 101,
      "title": "🎯 Divergence Alerts",
      "type": "row"
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "efkez839cfz7kd" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 14 },
      "id": 6,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Active Divergence Alerts (24h)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "efkez839cfz7kd" },
          "rawSql": "SELECT NOW() AS time, COUNT(DISTINCT entity_id) AS value FROM divergence_events WHERE time > NOW() - INTERVAL '24 hours'",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "efkez839cfz7kd" },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 }, "color": { "mode": "palette-classic" }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 7,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Divergence D-value over time (top tickers)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "efkez839cfz7kd" },
          "rawSql": "SELECT de.time, e.canonical_symbol AS metric, de.d_value AS value FROM divergence_events de JOIN entities e ON e.entity_id = de.entity_id WHERE $__timeFilter(de.time) ORDER BY de.time",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "efkez839cfz7kd" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" }, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 2 }, { "color": "red", "value": 3 }] } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 8,
      "options": { "footer": { "show": false }, "showHeader": true },
      "title": "Recent Divergence Alerts",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "efkez839cfz7kd" },
          "rawSql": "SELECT de.time, e.canonical_symbol AS ticker, ROUND(de.d_value::numeric, 2) AS d_value, ROUND(de.p_value::numeric, 4) AS p_value FROM divergence_events de JOIN entities e ON e.entity_id = de.entity_id WHERE $__timeFilter(de.time) ORDER BY de.time DESC LIMIT 50",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 102,
      "title": "📊 Sentiment Scores",
      "type": "row"
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "efkez839cfz7kd" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "continuous-GrYlRd" }, "unit": "short", "min": -1, "max": 1 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "id": 9,
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true },
      "title": "Top 15 Most Bullish Tickers (avg polarity)",
      "type": "bargauge",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "efkez839cfz7kd" },
          "rawSql": "SELECT e.canonical_symbol AS metric, AVG(ss.polarity) AS value FROM sentiment_scores ss JOIN entities e ON e.entity_id = ss.entity_id WHERE ss.time > NOW() - INTERVAL '24 hours' AND e.kind = 'ticker' GROUP BY e.canonical_symbol HAVING COUNT(*) >= 5 ORDER BY value DESC LIMIT 15",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "efkez839cfz7kd" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "continuous-RdYlGr" }, "unit": "short", "min": -1, "max": 1 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "id": 10,
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true },
      "title": "Top 15 Most Bearish Tickers (avg polarity)",
      "type": "bargauge",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "efkez839cfz7kd" },
          "rawSql": "SELECT e.canonical_symbol AS metric, AVG(ss.polarity) AS value FROM sentiment_scores ss JOIN entities e ON e.entity_id = ss.entity_id WHERE ss.time > NOW() - INTERVAL '24 hours' AND e.kind = 'ticker' GROUP BY e.canonical_symbol HAVING COUNT(*) >= 5 ORDER BY value ASC LIMIT 15",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "efkez839cfz7kd" },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 }, "color": { "mode": "palette-classic" }, "unit": "short", "min": -1, "max": 1 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 35 },
      "id": 11,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Sentiment polarity over time by source class",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "efkez839cfz7kd" },
          "rawSql": "SELECT $__timeGroupAlias(ss.time, '1h'), ss.source_class AS metric, AVG(ss.polarity) AS value FROM sentiment_scores ss WHERE $__timeFilter(ss.time) GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ]
    }
  ],
