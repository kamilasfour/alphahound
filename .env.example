# AlphaHound environment variables
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; never commit it.

# --- Database ---
# Azure Postgres Flexible Server — alphahound database
DATABASE_URL=postgresql://alphahound_admin:YOUR_PASSWORD_HERE@alphahound-rg.postgres.database.azure.com:5432/alphahound?sslmode=require

# --- Module salt for author hashing (PRD A9.2) ---
# SHA-256(author_salt + username) is stored; raw username is not.
# Generate per-module; change only if you want to invalidate existing hashes.
ALPHAHOUND_AUTHOR_SALT_STOCKS=change_me_to_a_long_random_string

# --- Optional: log level ---
ALPHAHOUND_LOG_LEVEL=INFO
